# ─── Copy this file to .env and fill in your values ─────────────────────────
PORT=5000

# Allowed origin for CORS — your frontend URL (no trailing slash)
# Local:      http://localhost:5173
# Production: https://ufsdigital.com
FRONTEND_ORIGIN=http://localhost:5173

# ─── MySQL Database ───────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ufs_digital
DB_CONNECTION_LIMIT=10

# Set DB_SSL=true if your host requires SSL (e.g. some cloud MySQL providers)
# DB_SSL=false

# ─── Admin JWT ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=replace-this-with-a-long-random-secret
ADMIN_JWT_EXPIRES_IN=8h
